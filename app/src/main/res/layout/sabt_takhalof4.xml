<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitis.sabt.ActivitySabteTakhalof4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">


        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="120dp"
            android:layout_marginRight="120dp"
            android:layout_marginBottom="50dp"
            android:layout_weight="1.9"
            app:srcCompat="@drawable/splashlogo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="60dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imageView7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="2.9"
                        app:srcCompat="@drawable/alfablank1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="70dp"
                        android:layout_marginRight="70dp"
                        android:layout_weight="2.7"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_add_car"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_plus" />

                        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                            android:id="@+id/searchablespinner_add_car"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                             />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_select_car"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="2.75"
                        android:layout_marginLeft="60dp"
                        android:layout_marginRight="60dp"
                        android:layout_marginBottom="15dp"
                        app:srcCompat="@drawable/btn_add_car" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="70dp"
                        android:layout_marginRight="70dp"
                        android:layout_weight="2.7"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/add_motor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_plus" />

                        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                            android:id="@+id/searchablespinner_add_motor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                             />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_sabt_motor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="2.75"
                        android:layout_marginBottom="15dp"
                        android:layout_marginLeft="60dp"
                        android:layout_marginRight="60dp"
                        app:srcCompat="@drawable/btn_add_motor" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="70dp"
                        android:layout_marginRight="70dp"
                        android:layout_weight="2.7"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/list_car_motor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_list" />

                        <TextView
                            android:id="@+id/car_motor_counter_txt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="وسیله اضافه شده:صفر" />


                    </LinearLayout>


                    <ImageView
                        android:id="@+id/imageView8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3.2"
                        app:srcCompat="@drawable/alfablank1" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/frame_naghlie" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/btn_sabtetakhalof4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="15dp"
                android:layout_weight="3.5"
                app:srcCompat="@drawable/btn_next" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>