<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/estelam_main_lyout"
    tools:context=".activitis.estelam.ActivityEstelam">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">


        <ImageView
            android:id="@+id/ghove_estelam"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="120dp"
            android:layout_marginRight="120dp"
            android:layout_marginBottom="50dp"
            android:layout_weight="1.9"
            app:srcCompat="@drawable/splashlogo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="80dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="80dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/b1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="2.6"
                        app:srcCompat="@drawable/alfablank1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="60dp"
                        android:layout_marginRight="60dp"
                        android:layout_weight="2.7"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_estelam_takhalof"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_takhalof" />

                        <ImageView
                            android:id="@+id/btn_estelam_vasile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_vasile" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/b2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3.5"
                        android:layout_marginLeft="60dp"
                        android:layout_marginRight="60dp"
                        app:srcCompat="@drawable/alfablank1" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="60dp"
                        android:layout_marginRight="60dp"
                        android:layout_weight="2.7"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_estelam_fard"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_fard" />

                        <ImageView
                            android:id="@+id/btn_estelam_makan"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2.7"
                            app:srcCompat="@drawable/btn_makan" />



                    </LinearLayout>


                    <ImageView
                        android:id="@+id/b3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        app:srcCompat="@drawable/alfablank1" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/b4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="50dp"
                    android:layout_marginRight="50dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/frame_estelam" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/new_sana"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_weight="3"
                app:srcCompat="@drawable/btn_newinfo" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>